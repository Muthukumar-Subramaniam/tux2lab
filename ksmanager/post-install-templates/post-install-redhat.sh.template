#!/bin/bash
set -x
# tux2lab post-install script for Red Hat family (RHEL/CentOS/Fedora)
# Generated by ksmanager — DO NOT EDIT MANUALLY
# Host: get_hostname.get_ipv4_domain | Distro: get_redhat_based_distro_name-get_version
# Generated: get_time_of_last_update

LOG=/root/tux2lab-post-install.log
exec > >(tee -a "$LOG") 2>&1
echo "tux2lab post-install started: $(date)"

######################################################################
# 0. CentOS Stream 8 EOL: switch from dead mirrorlist to vault.centos.org
######################################################################
if [[ -f /etc/centos-release ]] && grep -q "CentOS Stream release 8" /etc/centos-release 2>/dev/null; then
    /bin/sed -i 's/mirrorlist=/#mirrorlist=/g' /etc/yum.repos.d/CentOS-Stream-*.repo
    /bin/sed -i 's/#baseurl=/baseurl=/g' /etc/yum.repos.d/CentOS-Stream-*.repo
    /bin/sed -i 's/mirror.centos.org/vault.centos.org/g' /etc/yum.repos.d/CentOS-Stream-*.repo
fi

######################################################################
# 1. Persistent interface naming (eth0, eth1, ...)
######################################################################
/bin/mkdir -p /etc/systemd/network
V_count=0
for v_interface in $(/bin/ls /sys/class/net | /bin/grep -v lo); do
    v_mac=$(/sbin/ip link show "$v_interface" | /bin/grep link/ether | /bin/awk '{print $2}')
    /bin/echo -e "[Match]\nMACAddress=${v_mac}\n\n[Link]\nName=eth${V_count}" \
        > /etc/systemd/network/7${V_count}-eth${V_count}.link
    V_count=$((V_count + 1))
done

######################################################################
# 2. NetworkManager static IPv4+IPv6 dual-stack for eth0
######################################################################
# Back up DHCP connections from install environment
mkdir -p /root/system-connections/orig-during-install
/bin/cp -a /etc/NetworkManager/system-connections/* /root/system-connections/orig-during-install/ 2>/dev/null || true

# Remove all installer-generated connections
/bin/rm -rf /etc/NetworkManager/system-connections/*

/bin/cat > /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'
[connection]
id=eth0
type=ethernet
interface-name=eth0
autoconnect=true

[ethernet]
NMEOF

if [[ "get_stack_mode" != "ipv6" ]]; then
    /bin/cat >> /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'

[ipv4]
method=manual
address1=get_ipv4_address/get_ipv4_prefix,get_ipv4_gateway
dns=get_ipv4_nameserver;
dns-search=get_ipv4_domain;
NMEOF
else
    /bin/cat >> /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'

[ipv4]
method=disabled
NMEOF
fi

if [[ "get_stack_mode" == "ipv6" ]] && [[ -n "get_ipv6_address" ]]; then
    /bin/cat >> /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'

[ipv6]
method=manual
address1=get_ipv6_address/get_ipv6_prefix
dns=get_ipv6_nameserver;
dns-search=get_ipv4_domain;
NMEOF
elif [[ "get_stack_mode" != "ipv4" ]] && [[ -n "get_ipv6_address" ]]; then
    /bin/cat >> /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'

[ipv6]
method=manual
address1=get_ipv6_address/get_ipv6_prefix
dns=get_ipv6_nameserver;
dns-search=get_ipv4_domain;
NMEOF
else
    /bin/cat >> /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'

[ipv6]
method=disabled
NMEOF
fi

/bin/chmod 0600 /etc/NetworkManager/system-connections/eth0.nmconnection

######################################################################
# 3. SSH keys
######################################################################
/bin/mkdir -p /home/get_mgmt_super_user/.ssh /root/.ssh
/bin/chmod 0700 /home/get_mgmt_super_user/.ssh /root/.ssh

cat > /home/get_mgmt_super_user/.ssh/authorized_keys << 'EMBED_EOF'
EMBED_CONTENT:authorized_keys
EMBED_EOF

cat > /home/get_mgmt_super_user/.ssh/tux2lab_id_rsa.pub << 'EMBED_EOF'
EMBED_CONTENT:tux2lab_id_rsa.pub
EMBED_EOF

cat > /home/get_mgmt_super_user/.ssh/tux2lab_id_rsa << 'EMBED_EOF'
EMBED_CONTENT:tux2lab_id_rsa
EMBED_EOF

/bin/cp -p /home/get_mgmt_super_user/.ssh/{authorized_keys,tux2lab_id_rsa.pub,tux2lab_id_rsa} /root/.ssh/
/bin/chmod 0600 /home/get_mgmt_super_user/.ssh/{authorized_keys,tux2lab_id_rsa} /root/.ssh/{authorized_keys,tux2lab_id_rsa}
/bin/chmod 0644 /home/get_mgmt_super_user/.ssh/tux2lab_id_rsa.pub /root/.ssh/tux2lab_id_rsa.pub
/bin/chown -R get_mgmt_super_user:get_mgmt_super_user /home/get_mgmt_super_user/.ssh

######################################################################
# 4. Shell customization (HISTSIZE + PS1)
######################################################################
/usr/bin/echo -e "HISTSIZE=-1\nHISTFILESIZE=-1" | /usr/bin/tee -a /home/get_mgmt_super_user/.bashrc /root/.bashrc

cat >> /home/get_mgmt_super_user/.bashrc << 'EMBED_EOF'
EMBED_CONTENT:PS1-env-variable-normal-user
EMBED_EOF

cat >> /root/.bashrc << 'EMBED_EOF'
EMBED_CONTENT:PS1-env-variable-root-user
EMBED_EOF

######################################################################
# 5. Sudoers
######################################################################
/usr/bin/echo "get_mgmt_super_user ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/get_mgmt_super_user

######################################################################
# 6. Motd
######################################################################
cat > /etc/motd << 'EMBED_EOF'
EMBED_CONTENT:motd.txt
EMBED_EOF

######################################################################
# 7. CA certificate
######################################################################
cat > /etc/pki/ca-trust/source/anchors/tux2lab-nginx-selfsigned.crt << 'EMBED_EOF'
EMBED_CONTENT:ca-cert
EMBED_EOF
/usr/bin/update-ca-trust || true

######################################################################
# 8. Golden image setup (conditional)
######################################################################
if ! get_golden_image_creation_not_requested; then

cat > /etc/systemd/system/tux2lab-golden-boot.service << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-golden-boot.service
EMBED_EOF

cat > /root/tux2lab-golden-boot.sh << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-golden-boot.sh
EMBED_EOF
/bin/chmod +x /root/tux2lab-golden-boot.sh
/bin/ln -s /etc/systemd/system/tux2lab-golden-boot.service /etc/systemd/system/multi-user.target.wants/tux2lab-golden-boot.service

fi

######################################################################
# 9. tux2lab-sync agent (periodic config sync from lab server)
######################################################################
cat > /etc/tux2lab-sync.conf << EOF
LAB_SERVER="get_lab_infra_server_hostname"
ADMIN_USER="get_mgmt_super_user"
DISTRO_ID="get_os_distribution"
IPV6_GATEWAY="get_ipv6_gateway"
EOF
chmod 644 /etc/tux2lab-sync.conf

curl -fsSL "http://get_lab_infra_server_hostname/tux2lab/common-utils/tux2lab-sync" -o /usr/local/bin/tux2lab-sync
/bin/chmod +x /usr/local/bin/tux2lab-sync

cat > /etc/systemd/system/tux2lab-sync.service << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-sync.service
EMBED_EOF

cat > /etc/systemd/system/tux2lab-sync.timer << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-sync.timer
EMBED_EOF
/usr/bin/systemctl enable tux2lab-sync.timer

######################################################################
# 10. SSH client config
######################################################################
/bin/mkdir -p /etc/ssh/ssh_config.d
/usr/bin/cat << EOF > /etc/ssh/ssh_config.d/999-tux2lab.conf
Host *.get_ipv4_domain get_subnets_to_allow_ssh_pub_access
  IdentityFile ~/.ssh/tux2lab_id_rsa
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel QUIET
EOF

######################################################################
# 11. RHEL: unregister only for golden image builds (free slot
#     before disk capture). Direct PXE installs stay registered.
#     Remove rhc and insights-client (not needed in lab VMs).
######################################################################
if [[ "get_redhat_based_distro_name" == "rhel" ]]; then
    if ! get_golden_image_creation_not_requested; then
        /usr/sbin/subscription-manager unregister || true
        /usr/sbin/subscription-manager clean || true
    fi
    /usr/bin/dnf remove -y --noautoremove rhc insights-client || true
fi

######################################################################
# 12. systemd-resolved
######################################################################
/usr/bin/systemctl enable systemd-resolved.service
/usr/bin/ln -sf ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

######################################################################
# 13. Mask dnf-makecache
######################################################################
/usr/bin/systemctl mask dnf-makecache.timer dnf-makecache.service

######################################################################
# 14. Installation timestamp
######################################################################
/usr/bin/date '+%Y-%m-%d %H:%M:%S %Z' > /etc/bigbang

######################################################################
# 15. /etc/hosts self entry
######################################################################
# Without this the FQDN resolves to loopback, so anything that looks itself up
# to decide what address to advertise picks the wrong one.
if get_golden_image_creation_not_requested; then
    _stack_mode="get_stack_mode"
    _self_v4="get_ipv4_address"
    _self_v6="get_ipv6_address"
    # Command substitution strips trailing newlines, so re-running cannot stack blanks.
    _hosts_kept=$(/usr/bin/sed -e "/^# Added by tux2lab/d" -e "/^127\.0\.1\.1[[:space:]]/d" -e "/[[:space:]]get_hostname\(-ipv4\)\?\([[:space:]]\|\.\|$\)/d" /etc/hosts)
    printf '%s\n\n# Added by tux2lab PXE post-install\n' "${_hosts_kept}" > /etc/hosts
    if [[ "${_stack_mode}" != "ipv6" ]]; then
        printf '%s %s %s\n' "${_self_v4}" "get_hostname.get_ipv4_domain" "get_hostname" >> /etc/hosts
    fi
    if [[ "${_stack_mode}" != "ipv4" ]] && [[ -n "${_self_v6}" ]]; then
        printf '%s %s %s\n' "${_self_v6}" "get_hostname.get_ipv4_domain" "get_hostname" >> /etc/hosts
    fi
fi

echo "tux2lab post-install completed: $(date)"

######################################################################
# Golden image final cleanup (must be last — truncates all logs)
######################################################################
if ! get_golden_image_creation_not_requested; then
touch /root/golden-image-setup-completed
/usr/bin/truncate -s 0 /etc/hostname
/bin/rm -f /etc/ssh/ssh_host_*
/bin/rm -f /etc/systemd/system/multi-user.target.wants/sshd.service 2>/dev/null
/bin/rm -f /etc/NetworkManager/system-connections/* 2>/dev/null
cat << EOF > /etc/NetworkManager/system-connections/dhcp.nmconnection
[connection]
id=dhcp
type=ethernet
autoconnect=true

[ipv4]
method=auto

[ipv6]
method=auto
EOF
/bin/chmod 600 /etc/NetworkManager/system-connections/dhcp.nmconnection
/bin/rm -f /etc/systemd/network/*.link
/usr/bin/find /var/log -type f -exec /usr/bin/truncate -s 0 {} \;
/bin/rm -rf /var/log/journal/*
fi
