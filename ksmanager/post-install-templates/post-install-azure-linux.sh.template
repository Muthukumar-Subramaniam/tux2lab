#!/bin/bash
set -euo pipefail
# tux2lab post-install script for Azure Linux
# Generated by ksmanager — DO NOT EDIT MANUALLY
# Host: get_hostname.get_ipv4_domain | Distro: azure-linux-get_version
# Generated: get_time_of_last_update

LOG=/root/tux2lab-post-install.log
exec > >(tee -a "$LOG") 2>&1
echo "tux2lab post-install started: $(date)"

/usr/bin/date '+%Y-%m-%d %H:%M:%S %Z' > /etc/bigbang

/usr/bin/mkdir -p /home/get_mgmt_super_user/.ssh /root/.ssh
/usr/bin/chmod 0700 /home/get_mgmt_super_user/.ssh /root/.ssh

cat > /home/get_mgmt_super_user/.ssh/authorized_keys << 'EMBED_EOF'
EMBED_CONTENT:authorized_keys
EMBED_EOF

cat > /home/get_mgmt_super_user/.ssh/tux2lab_id_rsa.pub << 'EMBED_EOF'
EMBED_CONTENT:tux2lab_id_rsa.pub
EMBED_EOF

cat > /home/get_mgmt_super_user/.ssh/tux2lab_id_rsa << 'EMBED_EOF'
EMBED_CONTENT:tux2lab_id_rsa
EMBED_EOF

/usr/bin/cp -p /home/get_mgmt_super_user/.ssh/{authorized_keys,tux2lab_id_rsa.pub,tux2lab_id_rsa} /root/.ssh/
/usr/bin/chmod 0600 /home/get_mgmt_super_user/.ssh/{authorized_keys,tux2lab_id_rsa} /root/.ssh/{authorized_keys,tux2lab_id_rsa}
/usr/bin/chmod 0644 /home/get_mgmt_super_user/.ssh/tux2lab_id_rsa.pub /root/.ssh/tux2lab_id_rsa.pub
/usr/bin/chown -R get_mgmt_super_user:$(/usr/bin/id -gn get_mgmt_super_user) /home/get_mgmt_super_user/.ssh

/usr/bin/echo -e "HISTSIZE=-1\nHISTFILESIZE=-1" | /usr/bin/tee -a /home/get_mgmt_super_user/.bashrc /root/.bashrc

cat >> /home/get_mgmt_super_user/.bashrc << 'EMBED_EOF'
EMBED_CONTENT:PS1-env-variable-normal-user
EMBED_EOF

cat >> /root/.bashrc << 'EMBED_EOF'
EMBED_CONTENT:PS1-env-variable-root-user
EMBED_EOF

/usr/bin/echo "get_mgmt_super_user ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/get_mgmt_super_user
/usr/bin/chmod 0440 /etc/sudoers.d/get_mgmt_super_user

cat > /etc/motd << 'EMBED_EOF'
EMBED_CONTENT:motd.txt
EMBED_EOF

/usr/bin/mkdir -p /etc/pki/ca-trust/source/anchors
cat > /etc/pki/ca-trust/source/anchors/tux2lab-nginx-selfsigned.crt << 'EMBED_EOF'
EMBED_CONTENT:ca-cert
EMBED_EOF
/usr/bin/update-ca-trust extract || true

/usr/bin/mkdir -p /etc/systemd/network
V_count=0
for v_interface_path in /sys/class/net/*; do
    v_interface=${v_interface_path##*/}
    [[ "$v_interface" == "lo" ]] && continue
    v_mac=$(/usr/sbin/ip link show "$v_interface" | /usr/bin/awk '/link\/ether/ {print $2}')
    /usr/bin/printf '[Match]\nMACAddress=%s\n\n[Link]\nName=eth%s\n' "$v_mac" "$V_count" \
        > "/etc/systemd/network/7${V_count}-eth${V_count}.link"
    V_count=$((V_count + 1))
done

if get_golden_image_creation_not_requested; then
    {
        echo "[Match]"
        echo "Name=eth0"
        echo
        echo "[Network]"
        if [[ "get_stack_mode" != "ipv6" ]]; then
            echo "Address=get_ipv4_address/get_ipv4_prefix"
            echo "Gateway=get_ipv4_gateway"
            echo "DNS=get_ipv4_nameserver"
        fi
        if [[ "get_stack_mode" != "ipv4" ]]; then
            echo "Address=get_ipv6_address/get_ipv6_prefix"
            echo "DNS=get_ipv6_nameserver"
        fi
        echo "Domains=get_ipv4_domain"
        echo "IPv6AcceptRA=no"
    } > /etc/systemd/network/10-eth0.network
fi

/usr/bin/systemctl enable systemd-networkd.service systemd-resolved.service sshd.service

cat > /etc/tux2lab-sync.conf << EOF
LAB_SERVER="get_lab_infra_server_hostname"
ADMIN_USER="get_mgmt_super_user"
DISTRO_ID="get_os_distribution"
IPV6_GATEWAY="get_ipv6_gateway"
EOF
/usr/bin/chmod 0644 /etc/tux2lab-sync.conf

/usr/bin/curl -fsSL "http://get_ipv4_nfsserver/tux2lab/common-utils/tux2lab-sync" -o /usr/local/bin/tux2lab-sync
/usr/bin/chmod +x /usr/local/bin/tux2lab-sync

# Keep the install environment resolver until all network downloads finish.
/usr/bin/ln -sf ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

cat > /etc/systemd/system/tux2lab-sync.service << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-sync.service
EMBED_EOF

cat > /etc/systemd/system/tux2lab-sync.timer << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-sync.timer
EMBED_EOF
/usr/bin/systemctl enable tux2lab-sync.timer

/usr/bin/mkdir -p /etc/ssh/ssh_config.d
cat > /etc/ssh/ssh_config.d/999-tux2lab.conf << EOF
Host *.get_ipv4_domain get_subnets_to_allow_ssh_pub_access
  IdentityFile ~/.ssh/tux2lab_id_rsa
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel QUIET
EOF

if get_golden_image_creation_not_requested; then
    _hosts_kept=$(/usr/bin/sed -e "/^# Added by tux2lab/d" -e "/^127\.0\.1\.1[[:space:]]/d" -e "/[[:space:]]get_hostname\(-ipv4\)\?\([[:space:]]\|\.\|$\)/d" /etc/hosts)
    printf '%s\n\n# Added by tux2lab PXE post-install\n' "${_hosts_kept}" > /etc/hosts
    if [[ "get_stack_mode" != "ipv6" ]]; then
        printf '%s %s %s\n' "get_ipv4_address" "get_hostname.get_ipv4_domain" "get_hostname" >> /etc/hosts
    fi
    if [[ "get_stack_mode" != "ipv4" ]]; then
        printf '%s %s %s\n' "get_ipv6_address" "get_hostname.get_ipv4_domain" "get_hostname" >> /etc/hosts
    fi
else
    cat > /etc/systemd/system/tux2lab-golden-boot.service << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-golden-boot.service
EMBED_EOF

    cat > /root/tux2lab-golden-boot.sh << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-golden-boot.sh
EMBED_EOF
    /usr/bin/chmod +x /root/tux2lab-golden-boot.sh
    /usr/bin/ln -sf /etc/systemd/system/tux2lab-golden-boot.service /etc/systemd/system/multi-user.target.wants/tux2lab-golden-boot.service

    /usr/bin/touch /root/golden-image-setup-completed
    /usr/bin/truncate -s 0 /etc/hostname
    /usr/bin/rm -f /etc/ssh/ssh_host_*
    /usr/bin/rm -f /etc/systemd/system/multi-user.target.wants/sshd.service
    /usr/bin/rm -f /etc/systemd/network/10-eth0.network /etc/systemd/network/*.link
    /usr/bin/find /var/log -type f -exec /usr/bin/truncate -s 0 {} \;
    /usr/bin/rm -rf /var/log/journal/*
fi

echo "tux2lab post-install completed: $(date)"
