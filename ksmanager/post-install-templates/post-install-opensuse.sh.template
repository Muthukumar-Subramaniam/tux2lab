#!/bin/bash
set -x
# tux2lab post-install script for openSUSE Leap
# Generated by ksmanager — DO NOT EDIT MANUALLY
# Host: get_hostname.get_ipv4_domain | Distro: opensuse-leap-get_version
# Generated: get_time_of_last_update

LOG=/root/tux2lab-post-install.log
exec > >(tee -a "$LOG") 2>&1
echo "tux2lab post-install started: $(date)"

######################################################################
# 1. Installation timestamp
######################################################################
/usr/bin/date '+%Y-%m-%d %H:%M:%S %Z' > /etc/bigbang

######################################################################
# 2. Zypper repository management (deferred to first boot)
######################################################################
# All zypper operations are handled by tux2lab-zypper-firstboot.service instead.

######################################################################
# 4. SSH keys
######################################################################
/usr/bin/mkdir -p /home/get_mgmt_super_user/.ssh /root/.ssh
/usr/bin/chmod 0700 /home/get_mgmt_super_user/.ssh /root/.ssh

cat > /home/get_mgmt_super_user/.ssh/authorized_keys << 'EMBED_EOF'
EMBED_CONTENT:authorized_keys
EMBED_EOF

cat > /home/get_mgmt_super_user/.ssh/tux2lab_id_rsa.pub << 'EMBED_EOF'
EMBED_CONTENT:tux2lab_id_rsa.pub
EMBED_EOF

cat > /home/get_mgmt_super_user/.ssh/tux2lab_id_rsa << 'EMBED_EOF'
EMBED_CONTENT:tux2lab_id_rsa
EMBED_EOF

/usr/bin/cp -p /home/get_mgmt_super_user/.ssh/{authorized_keys,tux2lab_id_rsa.pub,tux2lab_id_rsa} /root/.ssh/
/usr/bin/chmod 0600 /home/get_mgmt_super_user/.ssh/{authorized_keys,tux2lab_id_rsa} /root/.ssh/{authorized_keys,tux2lab_id_rsa}
/usr/bin/chmod 0644 /home/get_mgmt_super_user/.ssh/tux2lab_id_rsa.pub /root/.ssh/tux2lab_id_rsa.pub
/usr/bin/chown -R get_mgmt_super_user:users /home/get_mgmt_super_user/.ssh

######################################################################
# 5. Shell customization (HISTSIZE + PS1)
######################################################################
/usr/bin/echo -e "HISTSIZE=-1\nHISTFILESIZE=-1" | /usr/bin/tee -a /home/get_mgmt_super_user/.bashrc /root/.bashrc

cat >> /home/get_mgmt_super_user/.bashrc << 'EMBED_EOF'
EMBED_CONTENT:PS1-env-variable-normal-user
EMBED_EOF

cat >> /root/.bashrc << 'EMBED_EOF'
EMBED_CONTENT:PS1-env-variable-root-user
EMBED_EOF

######################################################################
# 6. Sudoers
######################################################################
/usr/bin/echo "get_mgmt_super_user ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/get_mgmt_super_user

######################################################################
# 7. Motd
######################################################################
cat > /etc/motd << 'EMBED_EOF'
EMBED_CONTENT:motd.txt
EMBED_EOF

######################################################################
# 8. CA certificate
######################################################################
cat > /etc/pki/trust/anchors/tux2lab-nginx-selfsigned.crt << 'EMBED_EOF'
EMBED_CONTENT:ca-cert
EMBED_EOF
/usr/sbin/update-ca-certificates || true

######################################################################
# 9. Hostname via sysctl
######################################################################
/usr/bin/echo 'kernel.hostname=get_hostname.get_ipv4_domain' > /etc/sysctl.d/hostname.conf

######################################################################
# 10. tux2lab-sync agent (periodic config sync from lab server)
######################################################################
cat > /etc/tux2lab-sync.conf << EOF
LAB_SERVER="get_lab_infra_server_hostname"
ADMIN_USER="get_mgmt_super_user"
DISTRO_ID="get_os_distribution"
IPV6_GATEWAY="get_ipv6_gateway"
EOF
chmod 644 /etc/tux2lab-sync.conf

curl -fsSL "http://get_lab_infra_server_hostname/tux2lab/common-utils/tux2lab-sync" -o /usr/local/bin/tux2lab-sync
/bin/chmod +x /usr/local/bin/tux2lab-sync

cat > /etc/systemd/system/tux2lab-sync.service << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-sync.service
EMBED_EOF

cat > /etc/systemd/system/tux2lab-sync.timer << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-sync.timer
EMBED_EOF
/usr/bin/systemctl enable tux2lab-sync.timer

######################################################################
# 11. SSH client config
######################################################################
/usr/bin/mkdir -p /etc/ssh/ssh_config.d
cat << EOF > /etc/ssh/ssh_config.d/999-tux2lab.conf
Host *.get_ipv4_domain get_subnets_to_allow_ssh_pub_access
  IdentityFile ~/.ssh/tux2lab_id_rsa
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel QUIET
EOF

######################################################################
# 11. Services
######################################################################
systemctl disable firewalld 2>/dev/null || true
systemctl disable kdump 2>/dev/null || true
systemctl enable sshd
systemctl enable chronyd

######################################################################
# 12. Chrony NTP
######################################################################
/usr/bin/echo 'server get_lab_infra_server_hostname iburst' > /etc/chrony.d/tux2lab.conf
/usr/bin/rm -f /etc/chrony.d/pool.conf

######################################################################
# 13. Zypper repository cleanup and update
######################################################################
# Remove installation media repo left by Agama (hash-based alias, duplicate of repo-oss)
zypper repos --alias | awk -F'|' '/https-download.opensuse.org-/ {gsub(/^ +| +$/, "", $2); print $2}' | while read -r repo; do
    zypper --non-interactive removerepo "$repo" && echo "Removed install media repo: $repo"
done
# Enable repo-non-oss (disabled by default in Agama minimal install)
zypper --non-interactive modifyrepo --enable openSUSE:repo-non-oss 2>/dev/null && echo "Enabled repo-non-oss" || true

######################################################################
# 14. Stack-aware network reconfiguration (PXE installs only)
######################################################################
if get_golden_image_creation_not_requested; then
    /bin/rm -f /etc/NetworkManager/system-connections/*

    /bin/cat > /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'
[connection]
id=eth0
type=ethernet
interface-name=eth0
autoconnect=true

[ethernet]
NMEOF

    if [[ "get_stack_mode" != "ipv6" ]]; then
        /bin/cat >> /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'

[ipv4]
method=manual
address1=get_ipv4_address/get_ipv4_prefix,get_ipv4_gateway
dns=get_ipv4_nameserver;
dns-search=get_ipv4_domain;
NMEOF
    else
        /bin/cat >> /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'

[ipv4]
method=disabled
NMEOF
    fi

    if [[ "get_stack_mode" == "ipv6" ]]; then
        /bin/cat >> /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'

[ipv6]
method=manual
address1=get_ipv6_address/get_ipv6_prefix
dns=get_ipv6_nameserver;
dns-search=get_ipv4_domain;
NMEOF
    elif [[ "get_stack_mode" != "ipv4" ]]; then
        /bin/cat >> /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'

[ipv6]
method=manual
address1=get_ipv6_address/get_ipv6_prefix
dns=get_ipv6_nameserver;
dns-search=get_ipv4_domain;
NMEOF
    else
        /bin/cat >> /etc/NetworkManager/system-connections/eth0.nmconnection << 'NMEOF'

[ipv6]
method=disabled
NMEOF
    fi

    /bin/chmod 0600 /etc/NetworkManager/system-connections/eth0.nmconnection
    echo "Network configured: get_stack_mode stack"
fi

######################################################################
# 15. Golden image setup (conditional)
######################################################################
if ! get_golden_image_creation_not_requested; then

cat > /etc/systemd/system/tux2lab-golden-boot.service << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-golden-boot.service
EMBED_EOF

cat > /root/tux2lab-golden-boot.sh << 'EMBED_EOF'
EMBED_CONTENT:tux2lab-golden-boot.sh
EMBED_EOF
/bin/chmod +x /root/tux2lab-golden-boot.sh
/usr/bin/ln -s /etc/systemd/system/tux2lab-golden-boot.service /etc/systemd/system/multi-user.target.wants/tux2lab-golden-boot.service

fi

echo "tux2lab post-install completed: $(date)"

######################################################################
# Golden image final cleanup (must be last — truncates all logs)
######################################################################
if ! get_golden_image_creation_not_requested; then
touch /root/golden-image-setup-completed
/usr/bin/truncate -s 0 /etc/hostname
/bin/rm -f /etc/ssh/ssh_host_*
/bin/rm -f /etc/systemd/system/multi-user.target.wants/sshd.service 2>/dev/null
/bin/rm -f /etc/NetworkManager/system-connections/* 2>/dev/null
cat << EOF > /etc/NetworkManager/system-connections/dhcp.nmconnection
[connection]
id=dhcp
type=ethernet
autoconnect=true

[ipv4]
method=auto

[ipv6]
method=auto
EOF
/bin/chmod 600 /etc/NetworkManager/system-connections/dhcp.nmconnection
/bin/rm -f /etc/systemd/network/*.link
/usr/bin/find /var/log -type f -exec /usr/bin/truncate -s 0 {} \;
/bin/rm -rf /var/log/journal/*
fi
